{
  "name": "orion-worktree-report-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run test:demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:built": "node scripts/check-built.mjs",
    "test": "npm run build && npm run check:built && node scripts/check-ci-gate.mjs && node scripts/check-interaction.mjs",
    "test:demo": "node --test tests/product-demo.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
